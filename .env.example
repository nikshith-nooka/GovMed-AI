# LLM API Keys (Groq Cloud & NVIDIA NIM)
# Groq: https://console.groq.com (High-speed inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=your_key_1,your_key_2

# NVIDIA NIM: https://build.nvidia.com (Medical vision & reasoning models)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Benchmark Execution Defaults
DEFAULT_LLM_PROVIDER=groq
DEFAULT_MODEL=openai/gpt-oss-120b
BENCHMARK_DB_PATH=results/benchmark_results.db
