# ── GovBench-Clinical Environment Variables ────────────────────────────
# Copy this file to .env and fill in your keys.
#
# Only the provider you intend to use is required.
# The benchmark automatically falls back to deterministic mock mode
# when no API key is configured.

# Groq Cloud (default provider — fast, low-latency inference)
GROQ_API_KEY=your_groq_key_here
# For pooled key rotation (optional — used by the parallel benchmark runner)
GROQ_API_KEYS=groq_key_1,groq_key_2,groq_key_3

# NVIDIA NIM (production provider used in the paper — Llama 3.2 11B Vision)
NVIDIA_API_KEY=your_nvidia_nim_key_here
# Pooled keys for NVIDIA (optional)
NVIDIA_API_KEYS=nvidia_key_1,nvidia_key_2

# Google Gemini (alternative provider)
GEMINI_API_KEY=your_gemini_key_here

# OpenRouter (aggregator — access to multiple models)
OPENROUTER_API_KEY=your_openrouter_key_here

# ── API server hardening ───────────────────────────────────────────────
# When set, POST/run endpoints, /api/jobs, /api/experiments and /api/reviews/queue
# require the header `Authorization: Bearer <token>`. Leave empty for local use.
# Enter the same token in the web UI (profile menu > API token); it is kept in localStorage.
GOVBENCH_API_TOKEN=
# 1 = also require the token for every read-only /api GET (except /api/health).
GOVBENCH_AUTH_ALL=0
# Days to keep interactive job results (results/jobs.db) and experiment case text
# (results/ui_experiments.db). Purged at startup and hourly.
GOVBENCH_RETENTION_DAYS=30
# Optional override for the persistent job store location.
# GOVBENCH_JOBS_DB=results/jobs.db
