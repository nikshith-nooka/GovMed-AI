# ── GovBench-Clinical Environment Variables ────────────────────────────
# Copy this file to .env and fill in your keys.
#
# Only the provider you intend to use is required.
# The benchmark automatically falls back to deterministic mock mode
# when no API key is configured.

# Groq Cloud (default provider — fast, low-latency inference)
GROQ_API_KEY=your_groq_key_here
# For pooled key rotation (optional — used by the parallel benchmark runner)
GROQ_API_KEYS=groq_key_1,groq_key_2,groq_key_3

# NVIDIA NIM (production provider used in the paper — Llama 3.2 11B Vision)
NVIDIA_API_KEY=your_nvidia_nim_key_here
# Pooled keys for NVIDIA (optional)
NVIDIA_API_KEYS=nvidia_key_1,nvidia_key_2

# Google Gemini (alternative provider)
GEMINI_API_KEY=your_gemini_key_here

# OpenRouter (aggregator — access to multiple models)
OPENROUTER_API_KEY=your_openrouter_key_here
